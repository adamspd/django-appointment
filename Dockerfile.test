ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim

# Set the working directory in the container
WORKDIR /app

# Copy the current directory contents into the container at /app
COPY . /app

# Install any needed packages specified in requirements.txt
ARG DJANGO_VERSION=6.1
RUN pip install --no-cache-dir -r requirements-test.txt Django==${DJANGO_VERSION}

# django_q is only added to INSTALLED_APPS when this is set; django-q2 is installed
# by requirements-test.txt, so the suite needs it enabled to match CI.
ENV USE_DJANGO_Q=true

# Make port 8000 available to the world outside this container
EXPOSE 8000

# Number of test processes inside the container. compatibility_matrix.sh sets this
# per combination; override with `docker run -e TEST_PARALLEL=8`.
ENV TEST_PARALLEL=1

CMD ["sh", "-c", "python manage.py test --parallel=\"${TEST_PARALLEL}\""]
